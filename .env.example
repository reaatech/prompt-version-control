# ==========================================
# Prompt Version Control — Environment Config
# ==========================================
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ------------------------------------------
# Server
# ------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Public base URL the server is reachable at (used to build webhook callback URLs).
# Required when EVAL_HARNESS_URL is set.
# PUBLIC_API_URL=https://pvc.example.com

# Comma-separated allow-list of CORS origins. Use "*" to allow any origin.
# Default (empty) blocks cross-origin requests entirely.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# ------------------------------------------
# Database
# ------------------------------------------
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pvc_dev

# Prisma connection pool size (default: usually sufficient)
# DATABASE_CONNECTION_LIMIT=10

# Shadow database (required for Prisma Migrate in some cloud/dev environments)
# PRISMA_SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pvc_dev_shadow

# ------------------------------------------
# Cache
# ------------------------------------------
# Redis connection string
REDIS_URL=redis://localhost:6379

# Redis password (leave empty if not required)
# REDIS_PASSWORD=

# ------------------------------------------
# Security
# ------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET=

# API key hashing pepper. Strongly recommended in production: when set, API keys
# are hashed with HMAC-SHA-256(pepper, key) instead of plain SHA-256.
# Generate with: openssl rand -base64 32
API_KEY_PEPPER=

# Allow webhook URLs that resolve to private/loopback addresses. Only safe in
# trusted dev environments — never enable in production (SSRF risk).
# WEBHOOK_ALLOW_PRIVATE=0

# ------------------------------------------
# Eval Harness Integration
# ------------------------------------------
# Base URL of your eval harness service
EVAL_HARNESS_URL=http://localhost:4000

# HMAC-SHA-256 secret used to sign outbound calls to the harness AND to verify
# inbound /api/v1/evaluations/webhook callbacks. Generate with:
#   openssl rand -base64 32
EVAL_WEBHOOK_SECRET=

# ------------------------------------------
# Observability
# ------------------------------------------
# OpenTelemetry / Jaeger
# JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Prometheus push gateway (optional)
# PROMETHEUS_PUSH_GATEWAY=

# ------------------------------------------
# API docs
# ------------------------------------------
# Where to load Swagger UI assets from. Defaults to the public unpkg CDN; point
# this at a vendored copy for airgapped deployments.
# SWAGGER_UI_BASE_URL=https://unpkg.com/swagger-ui-dist@5

# Override the OpenAPI spec path (otherwise auto-discovered).
# OPENAPI_SPEC_PATH=/app/docs/api/openapi.yaml

# ------------------------------------------
# MCP Server
# ------------------------------------------
# MCP transport: stdio or sse
MCP_TRANSPORT=stdio

# If using SSE transport
# MCP_PORT=3001

# PVC API endpoint used by MCP server
PVC_API_URL=http://localhost:3000

# API key for MCP server to authenticate with PVC API
PVC_API_KEY=
