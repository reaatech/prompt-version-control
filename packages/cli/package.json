{
  "name": "@reaatech/prompt-version-control-cli",
  "version": "0.1.0",
  "description": "Prompt Version Control CLI",
  "license": "MIT",
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/reaatech/prompt-version-control.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/reaatech/prompt-version-control/issues"
  },
  "homepage": "https://github.com/reaatech/prompt-version-control/tree/main/packages/cli#readme",
  "keywords": [
    "prompt",
    "version-control",
    "cli"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pvc": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@reaatech/prompt-version-control-shared": "workspace:*",
    "@reaatech/prompt-version-control": "workspace:*",
    "clipanion": "^4.0.0-rc.4",
    "typanion": "^3.14.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.6"
  }
}
