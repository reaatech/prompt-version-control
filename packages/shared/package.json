{
  "name": "@reaatech/prompt-version-control-shared",
  "version": "0.1.0",
  "description": "Shared types, schemas, and utilities for Prompt Version Control",
  "license": "MIT",
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/reaatech/prompt-version-control.git",
    "directory": "packages/shared"
  },
  "bugs": {
    "url": "https://github.com/reaatech/prompt-version-control/issues"
  },
  "homepage": "https://github.com/reaatech/prompt-version-control/tree/main/packages/shared#readme",
  "keywords": [
    "prompt",
    "version-control",
    "types",
    "schemas"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "handlebars": "^4.7.8"
  },
  "peerDependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.6",
    "zod": "^3.23.0"
  }
}
