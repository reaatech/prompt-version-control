{
  "name": "@reaatech/prompt-version-control-server",
  "version": "0.1.0",
  "description": "Prompt Version Control API server",
  "license": "MIT",
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/reaatech/prompt-version-control.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/reaatech/prompt-version-control/issues"
  },
  "homepage": "https://github.com/reaatech/prompt-version-control/tree/main/packages/server#readme",
  "keywords": [
    "prompt",
    "version-control",
    "api",
    "hono",
    "prisma"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage .turbo *.tsbuildinfo",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@hono/zod-validator": "^0.9.0",
    "@prisma/client": "^5.15.0",
    "@reaatech/prompt-version-control-shared": "workspace:*",
    "hono": "^4.12.32",
    "ioredis": "^5.11.1",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "prom-client": "^15.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "prisma": "^5.15.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.6"
  }
}
